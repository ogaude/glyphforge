{
  "$defs": {
    "BlocklistPin": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "BlocklistPin",
      "type": "object"
    },
    "BoundsSpec": {
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "default": 6,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_scripts": {
          "default": 12,
          "maximum": 64,
          "minimum": 0,
          "title": "Max Scripts",
          "type": "integer"
        },
        "max_tokens": {
          "default": 500,
          "maximum": 4096,
          "minimum": 16,
          "title": "Max Tokens",
          "type": "integer"
        },
        "token_margin": {
          "default": 60,
          "minimum": 0,
          "title": "Token Margin",
          "type": "integer"
        }
      },
      "title": "BoundsSpec",
      "type": "object"
    },
    "CompositionSpec": {
      "additionalProperties": false,
      "properties": {
        "attempt_cap": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Attempt Cap",
          "type": "integer"
        },
        "hard_negative_ratio": {
          "default": 1.0,
          "minimum": 1.0,
          "title": "Hard Negative Ratio",
          "type": "number"
        },
        "shares": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares"
        },
        "total": {
          "default": 100,
          "minimum": 1,
          "title": "Total",
          "type": "integer"
        }
      },
      "title": "CompositionSpec",
      "type": "object"
    },
    "DegradeSpec": {
      "additionalProperties": false,
      "properties": {
        "blur": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clean_share": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Clean Share",
          "type": "number"
        },
        "contrast": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "jpeg": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "noise": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rotate": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DegradeSpec",
      "type": "object"
    },
    "ExportSpec": {
      "additionalProperties": false,
      "properties": {
        "blocklist": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlocklistPin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "degrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegradeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "formats": {
          "default": [],
          "items": {
            "enum": [
              "glyphfix",
              "parquet"
            ],
            "type": "string"
          },
          "title": "Formats",
          "type": "array"
        },
        "row_group_rows": {
          "default": 1000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Row Group Rows",
          "type": "integer"
        },
        "shard_mb": {
          "default": 500,
          "maximum": 4096,
          "minimum": 1,
          "title": "Shard Mb",
          "type": "integer"
        }
      },
      "title": "ExportSpec",
      "type": "object"
    },
    "Formula": {
      "additionalProperties": false,
      "description": "One source formula with its licence and, for CC BY material, the attribution fields.",
      "properties": {
        "authors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "env": {
          "default": "equation*",
          "title": "Env",
          "type": "string"
        },
        "latex": {
          "title": "Latex",
          "type": "string"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "paper_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Version"
        }
      },
      "required": [
        "latex",
        "licence"
      ],
      "title": "Formula",
      "type": "object"
    },
    "OpSpec": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "p": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        }
      },
      "title": "OpSpec",
      "type": "object"
    },
    "QCSpec": {
      "additionalProperties": false,
      "properties": {
        "ambiguity": {
          "default": "drop",
          "enum": [
            "drop",
            "flag"
          ],
          "title": "Ambiguity",
          "type": "string"
        }
      },
      "title": "QCSpec",
      "type": "object"
    },
    "RenderSpec": {
      "additionalProperties": false,
      "properties": {
        "pad_px": {
          "default": 0,
          "maximum": 64,
          "minimum": 0,
          "title": "Pad Px",
          "type": "integer"
        }
      },
      "title": "RenderSpec",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "domains": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "propertyNames": {
                "enum": [
                  "math",
                  "astro-ph",
                  "physics"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domains"
        },
        "formulas": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Formula"
          },
          "title": "Formulas",
          "type": "array"
        },
        "kind": {
          "default": "builtin",
          "enum": [
            "builtin",
            "inline",
            "file",
            "grammar",
            "mutation",
            "mix"
          ],
          "title": "Kind",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "enum": [
                "CC0-1.0",
                "CC-BY-3.0",
                "CC-BY-4.0"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "max_sites": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sites"
        },
        "parts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSpec"
          },
          "title": "Parts",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "shares": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares"
        }
      },
      "title": "SourceSpec",
      "type": "object"
    },
    "StructureSpec": {
      "additionalProperties": false,
      "properties": {
        "column_cm": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Column Cm",
          "type": "object"
        },
        "kinds": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {
            "display": 1.0,
            "inline": 0.0,
            "numbered": 0.0
          },
          "propertyNames": {
            "enum": [
              "display",
              "inline",
              "numbered"
            ]
          },
          "title": "Kinds",
          "type": "object"
        },
        "multiline": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Multiline",
          "type": "number"
        },
        "punct_prob": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Punct Prob",
          "type": "number"
        },
        "text_prob": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Text Prob",
          "type": "number"
        }
      },
      "title": "StructureSpec",
      "type": "object"
    },
    "StyleSpec": {
      "additionalProperties": false,
      "properties": {
        "font": {
          "enum": [
            "cm",
            "lmodern",
            "mathpazo",
            "newtx",
            "libertine",
            "stix2"
          ],
          "title": "Font",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "packages": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
            "type": "string"
          },
          "title": "Packages",
          "type": "array"
        },
        "size": {
          "maximum": 12,
          "minimum": 8,
          "title": "Size",
          "type": "integer"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "font",
        "size"
      ],
      "title": "StyleSpec",
      "type": "object"
    },
    "TypographySpec": {
      "additionalProperties": false,
      "properties": {
        "fonts": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "cm",
              "lmodern",
              "mathpazo",
              "newtx",
              "libertine",
              "stix2"
            ]
          },
          "title": "Fonts",
          "type": "object"
        },
        "packages": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
            "type": "string"
          },
          "title": "Packages",
          "type": "array"
        },
        "site_levels": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "base",
              "script",
              "scriptscript"
            ]
          },
          "title": "Site Levels",
          "type": "object"
        },
        "sizes": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Sizes",
          "type": "object"
        }
      },
      "title": "TypographySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bounds": {
      "$ref": "#/$defs/BoundsSpec",
      "default": {
        "max_depth": 6,
        "max_scripts": 12,
        "max_tokens": 500,
        "token_margin": 60
      }
    },
    "classes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Classes"
    },
    "composition": {
      "$ref": "#/$defs/CompositionSpec",
      "default": {
        "attempt_cap": 5,
        "hard_negative_ratio": 1.0,
        "shares": null,
        "total": 100
      }
    },
    "entry_points": {
      "default": false,
      "title": "Entry Points",
      "type": "boolean"
    },
    "export": {
      "$ref": "#/$defs/ExportSpec",
      "default": {
        "blocklist": null,
        "degrade": null,
        "formats": [],
        "row_group_rows": 1000,
        "shard_mb": 500
      }
    },
    "plugins": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
        "type": "string"
      },
      "title": "Plugins",
      "type": "array"
    },
    "qc": {
      "$ref": "#/$defs/QCSpec",
      "default": {
        "ambiguity": "drop"
      }
    },
    "render": {
      "$ref": "#/$defs/RenderSpec",
      "default": {
        "pad_px": 0
      }
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/SourceSpec",
      "default": {
        "domains": null,
        "formulas": [],
        "kind": "builtin",
        "licence": null,
        "max_sites": null,
        "parts": [],
        "path": null,
        "sha256": null,
        "shares": null
      }
    },
    "structure": {
      "$ref": "#/$defs/StructureSpec",
      "default": {
        "column_cm": {
          "12": 50.0,
          "15": 30.0,
          "8.5": 20.0
        },
        "kinds": {
          "display": 1.0,
          "inline": 0.0,
          "numbered": 0.0
        },
        "multiline": 0.2,
        "punct_prob": 0.2,
        "text_prob": 0.8
      }
    },
    "styles": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/StyleSpec"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Styles"
    },
    "typography": {
      "$ref": "#/$defs/TypographySpec",
      "default": {
        "fonts": {
          "cm": 55.0,
          "libertine": 6.0,
          "lmodern": 15.0,
          "mathpazo": 7.0,
          "newtx": 10.0,
          "stix2": 7.0
        },
        "packages": [],
        "site_levels": {
          "base": 60.0,
          "script": 30.0,
          "scriptscript": 10.0
        },
        "sizes": {
          "10": 35.0,
          "11": 25.0,
          "12": 30.0,
          "8": 3.0,
          "9": 7.0
        }
      }
    }
  },
  "title": "Recipe",
  "type": "object"
}
